# Local preview only. GitHub Pages builds this site on its own and ignores this file
# (it is excluded in _config.yml), but the github-pages gem pins the exact versions
# Pages runs, so a local build reproduces what will actually be deployed.
#
#   bundle install
#   bundle exec jekyll serve
#
# Verify a local build succeeds before pushing the first devlog post — a broken
# _config.yml fails the Pages build silently apart from an email.

source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# Bundled with Ruby < 3.0 but not after, and Jekyll needs them.
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "bigdecimal"
